# Copie este arquivo para .env.local (ja ignorado pelo git) e preencha os valores.
# Nunca commitar chaves reais. Estas variaveis so sao lidas no servidor
# (nao usam o prefixo VITE_, entao nunca vao para o bundle do cliente).

# URL base da instancia n8n, sem barra no final. Ex: https://n8n.suaempresa.com
N8N_BASE_URL=

# API key gerada em: n8n -> Settings -> n8n API -> "Create an API key"
N8N_API_KEY=

# Token gerado em: PipeRun -> Central de integracoes -> "Ver API token do usuario"
PIPERUN_API_KEY=

# Supabase -> Project Settings -> Data API. Use a service_role key (nunca a anon):
# esta chave ignora RLS e só e lida no servidor. Rode supabase/migrations/0001_create_incidents.sql
# no SQL Editor do projeto antes de configurar isso.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic -> console.anthropic.com/settings/keys. Usada só no servidor pelo
# assistente de IA das Tarefas (sugerir subtarefas, prioridade, resumo).
ANTHROPIC_API_KEY=

# Segredo usado pra selar o cookie de sessão do login (nunca exposto ao navegador).
# Gere um valor aleatório com pelo menos 32 caracteres, ex: openssl rand -hex 32
AUTH_SESSION_SECRET=
