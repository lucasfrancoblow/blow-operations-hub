# Copie este arquivo para .env.local (ja ignorado pelo git) e preencha os valores.
# Nunca commitar chaves reais. Estas variaveis so sao lidas no servidor
# (nao usam o prefixo VITE_, entao nunca vao para o bundle do cliente).

# URL base da instancia n8n, sem barra no final. Ex: https://n8n.suaempresa.com
N8N_BASE_URL=

# API key gerada em: n8n -> Settings -> n8n API -> "Create an API key"
N8N_API_KEY=

# Token gerado em: PipeRun -> Central de integracoes -> "Ver API token do usuario"
PIPERUN_API_KEY=

# Supabase -> Project Settings -> Data API. Use a service_role key (nunca a anon):
# esta chave ignora RLS e só e lida no servidor. Rode supabase/migrations/0001_create_incidents.sql
# no SQL Editor do projeto antes de configurar isso.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic -> console.anthropic.com/settings/keys. Usada só no servidor pelo
# assistente de IA das Tarefas (sugerir subtarefas, prioridade, resumo).
ANTHROPIC_API_KEY=

# Segredo usado pra selar o cookie de sessão do login (nunca exposto ao navegador).
# Gere um valor aleatório com pelo menos 32 caracteres, ex: openssl rand -hex 32
AUTH_SESSION_SECRET=

# Resend (resend.com) -> API Keys. Usada pras notificações por e-mail de
# Tarefas/Chamados (atribuição, aceite/recusa, comentário, chamado novo).
# Sem isso configurado, os e-mails só ficam inertes (nada quebra).
RESEND_API_KEY=
# Endereço remetente verificado no Resend, ex: notificacoes@meublow.com.br
RESEND_FROM_EMAIL=

# URL base do app (sem barra no final) usada pra montar o link "Ver tarefa"/
# "Ver chamado" nos e-mails. Opcional — sem isso, usa o domínio de produção
# conhecido (blow-operations-hub.vercel.app).
APP_URL=

# Service Account do Google Cloud com leitura no Drive, usada pra ler ao vivo a
# planilha "Daily Expansão" (Allana/Júlia/Andrey). Gere em: console.cloud.google.com ->
# IAM e admin -> Contas de servico -> criar conta -> Chaves -> Adicionar chave (JSON).
# Depois compartilhe o arquivo no Drive com o e-mail "client_email" do JSON abaixo.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Campo "private_key" do JSON da service account (mantenha as quebras de linha "\n"
# literais, como vêm no JSON — não precisa desescapar na mão).
GOOGLE_PRIVATE_KEY=

# 3C Plus (discador) -> painel -> Configurações -> Integrações -> API. Só usada pela
# tela "Chamadas do dia" (navegação pontual, ao vivo); o painel agregado de Ligações
# lê a tabela call_metrics_daily no Supabase, alimentada pelo job externo em
# scripts/sync-3cplus-calls.ts (agendado via .github/workflows/sync-3cplus-calls.yml,
# que usa esta mesma chave só como secret do GitHub Actions — não precisa duplicar
# aqui se você não for usar a navegação por dia).
THREECPLUS_API_KEY=
# ID do arquivo "Daily Expansão" no Drive (trecho entre /d/ e /edit na URL do arquivo).
GOOGLE_DAILY_EXPANSAO_FILE_ID=
